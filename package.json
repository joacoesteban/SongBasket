{
  "name": "songbasket",
  "version": "0.1.12-beta",
  "author": "Joaco Esteban <dev@joacoesteban.com>",
  "description": "Download your Spotify Playlists as MP3",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && vue-tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint . && bun run format:check",
    "lint:fix": "eslint . --fix && bun run format",
    "format": "prettier --write 'src/**/*.ts' 'src/**/*.css' 'src/**/*.scss' electron.vite.config.ts electron-builder.yml tsconfig.base.json tsconfig.main.json tsconfig.renderer.json eslint.config.mjs .prettierrc package.json && prettier --no-config --single-quote --no-semi --trailing-comma none --print-width 80 --write 'src/**/*.vue'",
    "format:check": "prettier --check 'src/**/*.ts' 'src/**/*.css' 'src/**/*.scss' electron.vite.config.ts electron-builder.yml tsconfig.base.json tsconfig.main.json tsconfig.renderer.json eslint.config.mjs .prettierrc package.json && prettier --no-config --single-quote --no-semi --trailing-comma none --print-width 80 --check 'src/**/*.vue'",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "publish": "electron-vite build && electron-builder --publish always"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joacoesteban/songbasket"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "axios": "^1.20.0",
    "chokidar": "^4.0.3",
    "electron-log": "^5.4.4",
    "electron-positioner": "^4.1.0",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "fluent-ffmpeg": "^2.1.3",
    "he": "^1.2.0",
    "iconv-lite": "^0.6.3",
    "jimp": "^0.22.12",
    "neverthrow": "^8.2.0",
    "node-id3": "^0.2.9",
    "to-ico": "^1.1.5",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.5",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^2.0.10",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/electron-positioner": "^4.1.4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/he": "^1.2.3",
    "@types/jquery": "^3.5.32",
    "@types/node": "^24.19.0",
    "@types/to-ico": "^1.1.3",
    "@vitejs/plugin-vue2": "^2.3.4",
    "better-typescript-lib": "^2.12.0",
    "change-case": "^5.4.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jquery": "^3.7.1",
    "less": "^4.9.1",
    "prettier": "^3.6.2",
    "sass": "^1.105.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vue": "^2.7.16",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^3.6.5",
    "vue-tsc": "^2.2.12",
    "vuex": "^3.6.2"
  },
  "optionalDependencies": {
    "fileicon": "^0.3.5"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "electron",
    "electron-winstaller",
    "esbuild"
  ]
}
