{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/@types/**/*.ts",
    "src/@types/**/*.d.ts",
    "src/MAIN_PROCESS_UTILS.ts",
    "src/UTILS.ts",
    "electron.vite.config.ts"
  ],
  "exclude": [
    "src/@types/vue.d.ts",
    "src/@types/vue-shim.d.ts",
    "src/@types/vuex.d.ts",
    "src/@types/window.d.ts"
  ]
}
